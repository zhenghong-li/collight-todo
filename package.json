{
  "name": "mori-desktop",
  "version": "1.3.1",
  "description": "拾光 · 住在桌面上的待办看板",
  "main": "electron/main.cjs",
  "author": "Mori",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/store.test.cjs tests/calendar.test.cjs",
    "test:e2e": "playwright test",
    "pack": "node scripts/build.cjs --dir",
    "dist": "node scripts/build.cjs nsis"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.mori.desktop",
    "productName": "Mori",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "src/**/*", "assets/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "拾光待办",
      "artifactName": "Mori-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
